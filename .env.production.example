# =========================================================================
# PRODUCTION ENVIRONMENT — FIT-TAX Cakrawala Sinergi
# =========================================================================
# Copy this file to `.env` on the Hostinger server and fill in real values.
# Never commit the real `.env` to git.
# -------------------------------------------------------------------------

# ---- Database (SQLite) -------------------------------------------------
# Absolute path to the SQLite database file ON THE SERVER.
# Example for Hostinger VPS (replace uXXXXXXX and domain):
#   DATABASE_URL=file:/home/uXXXXXXX/domains/cakrawalaintiteknik.com/app/db/custom.db
# The directory must exist and be writable. The file is created on first
# `prisma db push`. Keep this file backed up — it holds all site content
# (consultations, services, articles, team, admin users, settings).
DATABASE_URL=file:/home/USER/domains/DOMAIN/app/db/custom.db

# ---- Site URL ----------------------------------------------------------
# The public URL of the site (no trailing slash). Used for SEO metadata,
# OpenGraph, sitemap, and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://cakrawalaintiteknik.com

# ---- Admin credentials (used only by `bun run scripts/seed.ts`) --------
# Set a strong password here BEFORE running the seed on a fresh database.
# After seeding you can change the password from the admin panel.
ADMIN_EMAIL=admin@cakrawalaintiteknik.com
ADMIN_PASSWORD=ChangeThisToAStrongPassword123!
ADMIN_NAME=Administrator

# Set RESET_ADMIN=1 ONLY when you want the seed to overwrite the existing
# admin password (e.g. if you forgot it). Leave unset otherwise.
# RESET_ADMIN=1

# ---- Uploads directory (persistent) ------------------------------------
# Where uploaded images (team photos, etc.) are stored. Point this to a
# folder OUTSIDE the build output so uploads survive redeploys.
# Example: /home/uXXXXXXX/domains/DOMAIN/app/uploads
# Leave unset to default to <app>/public/uploads (fine for dev).
UPLOADS_DIR=/home/USER/domains/DOMAIN/app/uploads

# ---- Runtime -----------------------------------------------------------
# Port the Next.js standalone server listens on. On Hostinger VPS behind a
# reverse proxy (nginx) keep this as 3000 and proxy to it. Hostinger shared
# hosting (Passenger) sets PORT automatically — leave this unset there.
PORT=3000

# Set to production for the live site (enables secure session cookies, etc.)
NODE_ENV=production
